# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/shri_pundrik_goswami

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL (used by CORS and email links)
FRONTEND_URL=http://localhost:5173

# Admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345
ADMIN_NAME=Super Admin

# Cloudinary (optional, for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Shri Pundrik Goswami <no-reply@example.com>"
EMAIL_NOTIFY_TO=info@example.com
